# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=5000
MONGO_URI=mongodb://localhost:27017/aashraya

# At least 32 random characters. Changing it logs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# 64 hex characters. Encrypts journals, mood notes and safety plans.
# Back it up: if it's lost, that data can't be decrypted.
DATA_ENCRYPTION_KEY=

# Frontend URL(s), comma separated. Used for CORS and links in emails.
CLIENT_ORIGIN=http://localhost:5173
# APP_URL=https://aashraya.example.com   # defaults to the first CLIENT_ORIGIN

# Set to the number of proxies in front of the API in production (e.g. 1), so rate limits see real IPs.
# TRUST_PROXY=1

# Email (verification, password reset, reminders). Without SMTP_HOST, emails are printed to the console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Aashraya <no-reply@example.com>

# Hourly job that emails daily check-in reminders.
# REMINDERS_ENABLED=true

# Require admins to use two-factor sign-in before admin tools work (recommended in production).
# REQUIRE_ADMIN_2FA=true

# Web push notifications. Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Monthly check of resource links and center websites (admins are notified of broken ones).
# LINK_CHECK_ENABLED=true
